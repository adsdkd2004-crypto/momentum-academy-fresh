rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.role == 'admin';
    }
    function isApproved() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/students/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status == 'approved';
    }

    // Students can read/create their own profile; only admins can change status/role.
    match /students/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if isAdmin() ||
        (isSignedIn() && request.auth.uid == uid &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.status == resource.data.status);
      allow delete: if isAdmin();
    }

    // Study library content: readable by approved students, writable by admins only.
    match /chapters/{id} {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin();
    }
    match /materials/{id} {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin();
    }

    // Notices: public read, admin write.
    match /notices/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Contact form: anyone can submit, only admin can read/manage.
    match /messages/{id} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
