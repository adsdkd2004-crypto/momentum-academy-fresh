rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/students/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/students/$(request.auth.uid)).data.role == 'admin';
    }
    function isApproved() {
      return isSignedIn() &&
        firestore.exists(/databases/(default)/documents/students/$(request.auth.uid)) &&
        firestore.get(/databases/(default)/documents/students/$(request.auth.uid)).data.status == 'approved';
    }

    match /materials/{allPaths=**} {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin();
    }
  }
}
